{
  "name": "mask-network",
  "type": "module",
  "packageManager": "pnpm@8.15.8",
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=8.15.8"
  },
  "version": "2.26.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "dev",
    "start:mv2": "dev --manifest 2",
    "start:mv3": "dev --manifest 3",
    "start:fx": "dev --manifest firefox-mv2",
    "codegen": "gulp codegen-watch",
    "build": "build",
    "build:mv3": "build --manifest 3",
    "svgo": "svgo packages/icons/*/*.svg",
    "test": "vitest --no-threads",
    "spellcheck": "cspell lint --no-must-find-files",
    "clean": "npx gulp clean"
  },
  "dependencies": {
    "@dimensiondev/holoflows-kit": "0.9.0-20240322092738-f9180f3",
    "@masknet/kit": "0.3.0",
    "@tanstack/react-query": "^5.29.2",
    "@types/masknet__global-types": "workspace:^",
    "@typescript/lib-dom": "npm:@types/web@^0.0.197",
    "lodash-es": "^4.17.21",
    "react": "0.0.0-experimental-8039e6d0b-20231026",
    "react-dom": "0.0.0-experimental-8039e6d0b-20231026",
    "ses": "1.3.0",
    "ts-results-es": "^4.0.0"
  },
  "devDependencies": {
    "@masknet/cli": "workspace:^",
    "@masknet/config": "workspace:^",
    "@nice-labs/git-rev": "^3.5.1",
    "@swc-node/register": "^1.9.0",
    "@swc/core": "1.3.106",
    "@types/lodash-es": "^4.17.9",
    "@types/react": "19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/ui": "^0.34.3",
    "cross-fetch": "^4.0.0",
    "cspell": "^7.2.0",
    "gulp": "^4.0.2",
    "lint-staged": "^14.0.1",
    "msw": "^1.2.1",
    "prettier": "^3.1.0",
    "svgo": "^3.0.2",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "22.10.7",
      "@types/react": "19.0.2",
      "reflect-metadata": "0.1.13",
      "@tanstack/react-query": "^5.29.2"
    },
    "onlyBuiltDependencies": [],
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "@types/node",
        "@babel/core",
        "webextension-polyfill",
        "prop-types",
        "typescript"
      ],
      "allowedVersions": {
        "react": "0.0.0-experimental-8039e6d0b-20231026",
        "react-dom": "0.0.0-experimental-8039e6d0b-20231026",
        "typescript": "5",
        "rollup": "3"
      }
    },
    "patchedDependencies": {
      "urlcat@3.1.0": "patches/urlcat@3.1.0.patch",
      "web3-core@1.10.2": "patches/web3-core@1.10.2.patch",
      "gulp@4.0.2": "patches/gulp@4.0.2.patch",
      "react-use@17.5.1": "patches/react-use@17.5.1.patch"
    }
  }
}
