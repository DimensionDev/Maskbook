{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "inputs": ["./**/*.svg", "./**/*.jpg", "./**/*.jepg", "./**/*.png", "./**/*.webp"],
            "cache": true,
            "outputs": [
                "./icon-generated-as-jsx.d.ts",
                "./icon-generated-as-jsx.d.ts.map",
                "./icon-generated-as-jsx.js",
                "./icon-generated-as-url.d.ts",
                "./icon-generated-as-url.d.ts.map",
                "./icon-generated-as-url.js"
            ]
        }
    }
}
